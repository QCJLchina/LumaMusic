<Window x:Class="LumaMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LumaMusic" xmlns:controls="using:LumaMusic.Controls" Title="Luma Music">
 <Grid x:Name="Root" Background="{ThemeResource WindowFallback}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
  <controls:AmbientBackdrop x:Name="Ambient" Grid.RowSpan="3"/>
  <Grid x:Name="TitleBar" Grid.Row="0" Margin="24,0,140,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource Accent}"/><TextBlock Text="LUMA" FontSize="12" FontWeight="SemiBold" CharacterSpacing="250"/><TextBlock Text="MUSIC" FontSize="11" CharacterSpacing="180" Foreground="{ThemeResource TextSecondary}" Margin="2,2,0,0"/></StackPanel></Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{ThemeResource StrokeWeak}" BorderThickness="0,0,1,0" Background="{ThemeResource SidebarBackground}">
    <Grid Margin="16,24,16,18">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="你的音乐空间" FontSize="11" CharacterSpacing="90" Foreground="{ThemeResource TextSecondary}" Margin="17,0,0,20"/>
      <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Click="Library_Click" Background="#1DC9E8B1"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE8F1;" FontSize="17" Foreground="{ThemeResource Accent}"/><TextBlock Text="音乐库"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Click="Now_Click"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE767;" FontSize="17"/><TextBlock Text="正在播放"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Click="Favorites_Click"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xEB51;" FontSize="17"/><TextBlock Text="我的收藏"/></StackPanel></Button>
      <Border Height="1" Background="#14FFFFFF" Margin="14,24"/>
      <Grid Margin="16,0,7,12"><TextBlock Text="播放列表" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Padding="5" Click="NewPlaylist_Click" ToolTipService.ToolTip="新建播放列表"><FontIcon Glyph="&#xE710;" FontSize="12"/></Button></Grid>
      <StackPanel x:Name="PlaylistNav"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Spacing="7">
      <Button Style="{StaticResource NavButton}" Click="ImportFolder_Click"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE8B7;" FontSize="17"/><TextBlock Text="添加音乐"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE713;" FontSize="17"/><TextBlock Text="设置"/></StackPanel></Button>
      <Border Background="#0FFFFFFF" CornerRadius="14" Padding="14" Margin="0,12,0,0" BorderBrush="#15FFFFFF" BorderThickness="1">
       <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="5" Height="5" Fill="{ThemeResource Accent}"/><TextBlock Text="LOCAL. LOSSLESS. YOURS." FontSize="8" CharacterSpacing="90" Foreground="{ThemeResource TextSecondary}"/></StackPanel><TextBlock x:Name="LibraryCount" Text="等待第一张专辑" FontSize="11" Foreground="{ThemeResource TextSecondary}"/></StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="34,16,34,20">
    <Grid x:Name="LibraryPage">
     <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="230"/><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><StackPanel Spacing="5"><TextBlock Text="A LITTLE CLOSER TO THE MUSIC" FontSize="10" CharacterSpacing="190" Foreground="{ThemeResource TextSecondary}"/><TextBlock x:Name="PageTitle" Text="音乐库" FontSize="30" FontWeight="SemiBold"/></StackPanel><AutoSuggestBox x:Name="SearchBox" Width="250" HorizontalAlignment="Right" VerticalAlignment="Center" PlaceholderText="搜索歌曲、专辑、艺术家" QueryIcon="Find" TextChanged="Search_Changed" CornerRadius="20"/></Grid>
     <Border Grid.Row="1" CornerRadius="26" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="30,26" Background="{ThemeResource HeroBackground}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8"><Border Background="#1FC9E8B1" CornerRadius="5" Padding="7,3"><TextBlock Text="HI-RES AUDIO" FontSize="8" FontWeight="Bold" CharacterSpacing="120" Foreground="{ThemeResource Accent}"/></Border><TextBlock Text="为每一次认真聆听" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextSecondary}"/></StackPanel>
        <TextBlock Text="让声音，自然流淌。" FontSize="31" FontWeight="SemiBold" CharacterSpacing="-30"/>
        <TextBlock Text="从一张专辑开始，回到音乐本来的样子。" Foreground="{ThemeResource TextSecondary}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0"><Button Click="PlayAll_Click" Background="{ThemeResource Accent}" Foreground="{ThemeResource PlayIconColor}" BorderThickness="0" CornerRadius="18" Padding="20,10"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="12"/><TextBlock Text="播放全部" FontWeight="SemiBold" FontSize="12"/></StackPanel></Button><Button Click="ImportFolder_Click" CornerRadius="18" Padding="16,10"><TextBlock Text="导入音乐" FontSize="12"/></Button></StackPanel>
       </StackPanel>
       <Grid Grid.Column="1" Width="168" Height="168" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse Fill="#1DD6EDC5"/><Ellipse Margin="12" Stroke="#33DBEACC" StrokeThickness="1"/><Ellipse Margin="24" Stroke="#20DBEACC" StrokeThickness="1"/><Ellipse Margin="38" Stroke="#22DBEACC" StrokeThickness="1"/><Ellipse Margin="54" Fill="#15394639" Stroke="#28FFFFFF"/><Ellipse Margin="68" Fill="#3779977E"/><FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="#D5E8CC"/>
        <Border Width="114" Height="27" CornerRadius="13" Background="#654C6453" BorderBrush="#3BFFFFFF" BorderThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-5,8"><TextBlock Text="PURE SOUND" FontSize="8" CharacterSpacing="150" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       </Grid>
      </Grid>
     </Border>
     <Grid Grid.Row="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SongsTab" Click="SongsTab_Click" CornerRadius="16" Padding="15,7" Background="{ThemeResource ButtonFillStrong}"><TextBlock Text="歌曲" FontSize="12"/></Button><Button x:Name="AlbumsTab" Click="AlbumsTab_Click" CornerRadius="16" Padding="15,7" Style="{StaticResource QuietButton}"><TextBlock Text="专辑" FontSize="12"/></Button><Button Click="ArtistsTab_Click" CornerRadius="16" Padding="15,7" Style="{StaticResource QuietButton}"><TextBlock Text="艺术家" FontSize="12"/></Button></StackPanel><TextBlock x:Name="TrackCount" Text="0 首歌曲" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextSecondary}"/></Grid>
     <Grid Grid.Row="3">
      <ListView x:Name="TrackList" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="Single" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,7"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Margin" Value="0,2"/></Style></ListView.ItemContainerStyle>
       <ListView.ItemTemplate><DataTemplate x:DataType="local:Track"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="50"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="9" Background="#254B6557"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="17" Foreground="#81BDCEB2"/><Image Source="{x:Bind local:Track.CoverImage(Cover),Mode=OneWay}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Quality}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" FontSize="11"/><TextBlock Grid.Column="3" Text="{x:Bind DurationText}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" FontSize="11"/><Button Grid.Column="4" Tag="{x:Bind}" Click="FavoriteTrack_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="收藏"><FontIcon Glyph="{x:Bind FavoriteGlyph,Mode=OneWay}" FontSize="14"/></Button><Button Grid.Column="5" Tag="{x:Bind}" Click="TrackMenu_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="曲目选项"><FontIcon Glyph="&#xE712;" FontSize="14"/></Button></Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <GridView x:Name="AlbumGrid" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="Album_ItemClick" SelectionMode="None">
       <GridView.ItemTemplate><DataTemplate x:DataType="local:Track"><StackPanel Width="160" Margin="5,5,12,15" Spacing="8"><Border Height="160" CornerRadius="18" Background="#294B6557" BorderBrush="#1FFFFFFF" BorderThickness="1"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="42" Foreground="#70BCD7AF"/><Image Source="{x:Bind local:Track.CoverImage(Cover),Mode=OneWay}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{x:Bind Album}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></GridView.ItemTemplate>
      </GridView>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="#78938A"/><TextBlock x:Name="EmptyTitle" Text="你的音乐，值得一个好位置。" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="拖入音频文件或文件夹，也可以点击「添加音乐」" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center"/><TextBlock Text="MP3  /  FLAC  /  DSD  /  SACD ISO" FontSize="10" CharacterSpacing="120" Foreground="#758C81" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
     </Grid>
    </Grid>
    <Grid x:Name="NowPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
     <Grid><Button Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="Library_Click"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE72B;" FontSize="12"/><TextBlock Text="返回音乐库" FontSize="11"/></StackPanel></Button><TextBlock Text="NOW PLAYING" FontSize="11" CharacterSpacing="240" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Click="LyricsMenu_Click" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="封面与歌词"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button></Grid>
     <Grid Grid.Row="1" x:Name="NowColumns" ColumnSpacing="44" Padding="12,12,8,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="21">
       <Border x:Name="LargeCover" CornerRadius="28" BorderBrush="#40FFFFFF" BorderThickness="1" Background="#335E7866" Height="310" MaxWidth="360" HorizontalAlignment="Stretch">
        <Grid><Ellipse Width="180" Height="180" Stroke="#21FFFFFF" StrokeThickness="1"/><Ellipse Width="130" Height="130" Stroke="#21FFFFFF" StrokeThickness="1"/><FontIcon Glyph="&#xE8D6;" FontSize="58" Foreground="#B5D4BB"/><Image x:Name="CoverImage" Stretch="UniformToFill"/></Grid>
       </Border>
       <Border x:Name="CoverReflection" Height="84" Margin="14,-8,14,0" Opacity="0.55"/>
       <StackPanel Spacing="7"><TextBlock x:Name="NowTitle" Text="留一点时间，给音乐。" FontSize="25" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2"/><TextBlock x:Name="NowArtist" Text="选择一首歌，开始聆听" FontSize="13" Foreground="#B6C6BC" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowAlbum" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel>
      </StackPanel>
      <Grid Grid.Column="1" Margin="0,20,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="5" Height="5" Fill="{ThemeResource Accent}"/><TextBlock Text="LYRICS" FontSize="10" CharacterSpacing="180" Foreground="{ThemeResource TextSecondary}"/></StackPanel><Button Click="FindLyrics_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="4" ToolTipService.ToolTip="联网查找歌词"><FontIcon Glyph="&#xE721;" FontSize="12"/></Button></Grid><ScrollViewer x:Name="LyricsScroll" Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Hidden"><StackPanel x:Name="LyricsPanel" Spacing="22" Padding="0,40,0,120"/></ScrollViewer><TextBlock x:Name="LyricsPlaceholder" Grid.Row="1" Text="歌词会在这里，随着音乐浮现。" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="21" LineHeight="36" Foreground="{ThemeResource TextSecondary}"/></Grid>
     </Grid>
     <Border Grid.Row="2" VerticalAlignment="Center" CornerRadius="18" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="16,12" Background="{ThemeResource SignalChipBackground}"><Grid><TextBlock x:Name="SignalPath" Text="等待播放 · 选择音频输出设备" Foreground="#B0C8BA" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,85,0" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Click="Settings_Click" Style="{StaticResource QuietButton}" Padding="5,0"><TextBlock Text="输出设置  ↗" FontSize="11"/></Button></Grid></Border>
    </Grid>
   </Grid>
   <Border x:Name="QueuePanel" Grid.Column="1" Width="340" HorizontalAlignment="Right" Visibility="Collapsed" CornerRadius="24,0,0,24" BorderBrush="#38FFFFFF" BorderThickness="1" Padding="22" Background="{ThemeResource QueueBackground}"><Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="接下来播放" FontSize="20" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Queue_Click" Style="{StaticResource QuietButton}" Padding="5"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button><ListView Grid.Row="1" x:Name="QueueList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Queue_ItemClick"><ListView.ItemTemplate><DataTemplate x:DataType="local:Track"><StackPanel Margin="0,7" Spacing="5"><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextSecondary}" FontSize="11"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Click="QueueUp_Click" Padding="10,5"><TextBlock Text="上移" FontSize="11"/></Button><Button Click="QueueRemove_Click" Padding="10,5"><TextBlock Text="移除" FontSize="11"/></Button></StackPanel></Grid></Border>
  </Grid>
  <Border Grid.Row="2" Margin="20,0,20,14" CornerRadius="26" BorderBrush="{ThemeResource StrokeWeak}" BorderThickness="1" VerticalAlignment="Bottom" Background="{ThemeResource BottomBarBackground}">
   <Grid Margin="25,11" ColumnSpacing="25" ColumnDefinitions="260,*,210">
    <Grid ColumnSpacing="13"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Button x:Name="MiniCover" Click="Now_Click" Padding="0" Width="58" Height="58" CornerRadius="13" Background="#335A7360"><Grid><FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource TextSecondary}" FontSize="21"/><Image x:Name="MiniCoverImage" Stretch="UniformToFill"/></Grid></Button><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock x:Name="MiniTitle" Text="还没有正在播放的音乐" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MiniArtist" Text="让喜欢的声音陪伴你" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Click="FavoriteCurrent_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="收藏"><FontIcon x:Name="CurrentHeart" Glyph="&#xEB51;" FontSize="16"/></Button></Grid>
    <Grid Grid.Column="1" ColumnSpacing="14" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"><Button Click="Shuffle_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="随机播放"><FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/></Button><Button Click="Previous_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="上一首"><FontIcon Glyph="&#xE892;" FontSize="18"/></Button><Button x:Name="PlayButton" Click="PlayPause_Click" Width="40" Height="40" CornerRadius="20" Background="{ThemeResource Accent}" Foreground="{ThemeResource PlayIconColor}" BorderThickness="0" Padding="0" ToolTipService.ToolTip="播放 / 暂停（空格）"><FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="17"/></Button><Button Click="Next_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="下一首"><FontIcon Glyph="&#xE893;" FontSize="18"/></Button><Button Click="Repeat_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="循环模式"><FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/></Button></StackPanel><TextBlock Grid.Column="1" x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center"/><Slider Grid.Column="2" x:Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="Seek_Changed" IsThumbToolTipEnabled="False" VerticalAlignment="Center" Height="24"/><TextBlock Grid.Column="3" x:Name="Total" Text="0:00" FontSize="10" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Click="Settings_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="音频输出"><FontIcon Glyph="&#xE7F5;" FontSize="15"/></Button><FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/><Slider x:Name="VolumeSlider" Width="72" Minimum="0" Maximum="100" Value="80" ValueChanged="Volume_Changed" ToolTipService.ToolTip="软件音量：DSD 透传时使用 DAC 控制"/><Button Click="Queue_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="播放队列"><FontIcon Glyph="&#xE8EF;" FontSize="17"/></Button></StackPanel>
   </Grid>
  </Border>
  <InfoBar x:Name="Notice" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="650" Margin="215,0,20,0" IsOpen="False" IsClosable="True" Severity="Informational"/>
  <ProgressBar x:Name="BusyBar" Grid.Row="2" VerticalAlignment="Top" Height="2" IsIndeterminate="True" Visibility="Collapsed" Foreground="{ThemeResource Accent}"/>
 </Grid>
</Window>
