<Window xmlns:local="using:LumaMusic" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:LumaMusic.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LumaMusic.MainWindow" Title="Luma Music">
  <Grid x:Name="Root" Background="{ThemeResource WindowFallback}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="112" />
    </Grid.RowDefinitions>
    <controls:AmbientBackdrop x:Name="Ambient" Grid.RowSpan="3" IsHitTestVisible="False" />
    <Grid x:Name="TitleBar" Grid.Row="0" Margin="24,0,140,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource Accent}" />
        <TextBlock Text="LUMA" FontSize="12" FontWeight="SemiBold" CharacterSpacing="250" />
        <TextBlock Text="MUSIC" FontSize="12" CharacterSpacing="180" Foreground="{ThemeResource TextSecondary}" Margin="2,2,0,0" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" x:Name="Workspace" Margin="20,8,20,16" ColumnSpacing="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208" x:Name="SidebarColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:GlassSurface x:Name="SidebarGlass" Preset="Navigation">
        <Grid Margin="12,20,12,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <Grid x:Name="MainNavigation">
              <Border Height="48" CornerRadius="24" Background="{ThemeResource ButtonFillStrong}" VerticalAlignment="Top" IsHitTestVisible="False" x:Name="NavSelection" />
              <StackPanel Spacing="4">
                <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Click="Library_Click" ToolTipService.ToolTip="音乐库" AutomationProperties.Name="音乐库">
                  <StackPanel Orientation="Horizontal" Spacing="15">
                    <FontIcon Glyph="" FontSize="17" Foreground="{ThemeResource Accent}" />
                    <TextBlock Text="音乐库" x:Name="LibraryNavLabel" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Click="Now_Click" x:Name="NowNav" ToolTipService.ToolTip="正在播放" AutomationProperties.Name="正在播放">
                  <StackPanel Orientation="Horizontal" Spacing="15">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="正在播放" x:Name="NowNavLabel" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Click="Favorites_Click" x:Name="FavoritesNav" ToolTipService.ToolTip="我的收藏" AutomationProperties.Name="我的收藏">
                  <StackPanel Orientation="Horizontal" Spacing="15">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="我的收藏" x:Name="FavoritesNavLabel" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Grid Margin="6,20,0,8">
              <TextBlock Text="播放列表" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" x:Name="PlaylistHeading" />
              <Button HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Padding="5" Click="NewPlaylist_Click" ToolTipService.ToolTip="新建播放列表" AutomationProperties.Name="新建播放列表">
                <FontIcon Glyph="" FontSize="12" />
              </Button>
            </Grid>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PlaylistNav" />
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="7">
            <Button Style="{StaticResource NavButton}" Click="ImportFolder_Click" ToolTipService.ToolTip="添加音乐" AutomationProperties.Name="添加音乐">
              <StackPanel Orientation="Horizontal" Spacing="15">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="添加音乐" x:Name="ImportNavLabel" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavButton}" Click="Settings_Click" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
              <StackPanel Orientation="Horizontal" Spacing="15">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="设置" x:Name="SettingsNavLabel" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="LibraryCount" Text="等待第一张专辑" FontSize="12" Foreground="{ThemeResource TextSecondary}" Margin="14,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </controls:GlassSurface>
      <Grid Grid.Column="1" Margin="0,6,8,0" x:Name="ContentHost">
        <Grid x:Name="LibraryPage" RowSpacing="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="5" Margin="0,0,230,0">
              <TextBlock Text="为喜欢的声音，留一个位置" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
              <TextBlock x:Name="PageTitle" Text="音乐库" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="搜索歌曲、专辑、艺术家" QueryIcon="Find" TextChanged="Search_Changed" CornerRadius="20" Grid.Row="1" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
              <Button Click="PlayAll_Click" Content="播放全部" CornerRadius="22" Background="{ThemeResource Accent}" Foreground="{ThemeResource PlayIconColor}" />
              <Button Click="ImportFolder_Click" Content="导入音乐" CornerRadius="22" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" Background="{ThemeResource ButtonFill}" CornerRadius="22" Padding="4" HorizontalAlignment="Left">
              <Button x:Name="AlbumsTab" Click="AlbumsTab_Click" Style="{StaticResource SegmentButton}">
                <TextBlock Text="专辑" FontSize="14" />
              </Button>
              <Button x:Name="SongsTab" Click="SongsTab_Click" Style="{StaticResource SegmentButton}">
                <TextBlock Text="歌曲" FontSize="14" />
              </Button>
              <Button Click="ArtistsTab_Click" Style="{StaticResource SegmentButton}" x:Name="ArtistsTab">
                <TextBlock Text="艺术家" FontSize="14" />
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
              <TextBlock x:Name="TrackCount" Text="0 首歌曲" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
              <Button x:Name="MultiSelectButton" Click="MultiSelect_Click" Content="多选" Style="{StaticResource QuietButton}" Padding="12,6" />
            </StackPanel>
            <Button Click="BrowseBack_Click" Content="返回浏览" Style="{StaticResource QuietButton}" Margin="285,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed" x:Name="BrowseBack" />
          </Grid>
          <Grid Grid.Row="2">
            <ListView x:Name="TrackList" IsItemClickEnabled="True" ItemClick="Track_ItemClick" DoubleTapped="Track_DoubleTapped" SelectionChanged="TrackList_SelectionChanged" SelectionMode="Single" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="8,7" />
                  <Setter Property="CornerRadius" Value="12" />
                  <Setter Property="Margin" Value="0,2" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Track">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="9" Background="{ThemeResource ButtonFill}">
                      <Grid>
                        <FontIcon Glyph="" FontSize="17" Foreground="{ThemeResource TextSecondary}" />
                        <Image Source="{x:Bind local:Track.CoverImage(Cover),Mode=OneWay}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="14" />
                      <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Quality}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                    <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                    <Button Grid.Column="4" Tag="{x:Bind}" Click="FavoriteTrack_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏">
                      <FontIcon Glyph="{x:Bind FavoriteGlyph,Mode=OneWay}" FontSize="14" />
                    </Button>
                    <Button Grid.Column="5" Tag="{x:Bind}" Click="TrackMenu_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="曲目选项" AutomationProperties.Name="曲目选项">
                      <FontIcon Glyph="" FontSize="14" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <Border x:Name="BatchBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Stretch" CornerRadius="18" Padding="12,8" Background="{ThemeResource ButtonFillStrong}" BorderBrush="{ThemeResource ButtonStroke}" BorderThickness="1" Canvas.ZIndex="10">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="SelectedCount" Text="已选择 0 首" VerticalAlignment="Center" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                  <Button Click="BatchPlay_Click" Content="播放" Padding="10,5" />
                  <Button Click="BatchNext_Click" Content="下一首" Padding="10,5" />
                  <Button Click="BatchPlaylist_Click" Content="加入歌单" Padding="10,5" />
                  <Button Click="BatchFavorite_Click" Content="收藏" Padding="10,5" />
                  <Button Click="BatchUnfavorite_Click" Content="取消收藏" Padding="10,5" />
                  <Button Click="BatchRemove_Click" Content="移除" Padding="10,5" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                  <Button Click="SelectAll_Click" Content="全选" Style="{StaticResource QuietButton}" Padding="8,5" />
                  <Button Click="MultiSelect_Click" Content="完成" Style="{StaticResource QuietButton}" Padding="8,5" />
                </StackPanel>
              </Grid>
            </Border>
            <GridView x:Name="AlbumGrid" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="Album_ItemClick" SelectionMode="None">
              <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:Track">
                  <StackPanel Width="160" Margin="5,5,12,15" Spacing="8">
                    <Border Height="160" CornerRadius="18" Background="{ThemeResource ButtonFill}" BorderBrush="{ThemeResource StrokeWeak}" BorderThickness="1">
                      <Grid>
                        <FontIcon Glyph="" FontSize="42" Foreground="{ThemeResource TextSecondary}" />
                        <Image Source="{x:Bind local:Track.CoverImage(Cover),Mode=OneWay}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Album}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Artist}" FontSize="12" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="330">
              <FontIcon Glyph="" FontSize="28" Foreground="{ThemeResource TextSecondary}" />
              <TextBlock x:Name="EmptyTitle" Text="你的音乐，值得一个好位置。" FontSize="17" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              <TextBlock Text="拖入音频文件或文件夹，也可以点击「添加音乐」" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Content="添加音乐" Click="ImportFolder_Click" HorizontalAlignment="Center" CornerRadius="22" />
            </StackPanel>
            <ListView Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="Artist_ItemClick" SelectionMode="None" x:Name="ArtistList">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ArtistSummary">
                  <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="8,12">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource ButtonFill}">
                      <FontIcon Glyph="" FontSize="22" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{x:Bind Name}" FontSize="16" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Grid>
        <Grid x:Name="NowPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
          </Grid.RowDefinitions>
          <Grid>
            <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="NowBack_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="" FontSize="12" />
                <TextBlock Text="返回音乐库" FontSize="12" />
              </StackPanel>
            </Button>
            <TextBlock Text="正在播放" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Click="LyricsMenu_Click" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="封面与歌词" AutomationProperties.Name="封面与歌词">
              <FontIcon Glyph="" FontSize="16" />
            </Button>
          </Grid>
          <Grid Grid.Row="1" x:Name="NowColumns" ColumnSpacing="30" Padding="12,12,8,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="CoverScroll">
              <StackPanel VerticalAlignment="Center" Spacing="0" Margin="12,12,12,12">
                <Border x:Name="LargeCover" CornerRadius="28" BorderBrush="{ThemeResource StrokeWeak}" BorderThickness="1" Background="{ThemeResource ButtonFill}" Height="310" MaxWidth="360" HorizontalAlignment="Center" Width="310" Translation="0,0,28">
                  <Border.Shadow>
                    <ThemeShadow />
                  </Border.Shadow>
                  <Grid>
                    <Ellipse Width="180" Height="180" Stroke="#21FFFFFF" StrokeThickness="1" />
                    <Ellipse Width="130" Height="130" Stroke="#21FFFFFF" StrokeThickness="1" />
                    <FontIcon Glyph="" FontSize="58" Foreground="{ThemeResource TextSecondary}" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <Border x:Name="CoverReflection" Height="100" Width="310" MaxWidth="360" HorizontalAlignment="Center" Opacity="0.16" RenderTransformOrigin="0.5,0.5" CornerRadius="0,0,24,24">
                  <Border.RenderTransform><ScaleTransform ScaleY="-1" /></Border.RenderTransform>

                  <Image x:Name="ReflectionImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Spacing="7" Margin="0,10,0,0">
                  <TextBlock x:Name="NowTitle" Text="留一点时间，给音乐。" FontSize="25" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2" />
                  <TextBlock x:Name="NowArtist" Text="选择一首歌，开始聆听" FontSize="14" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="NowAlbum" FontSize="12" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" Margin="0,20,0,10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="5" Height="5" Fill="{ThemeResource Accent}" />
                  <TextBlock Text="歌词" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>
                <Button Click="FindLyrics_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="4" ToolTipService.ToolTip="联网查找歌词" AutomationProperties.Name="联网查找歌词">
                  <FontIcon Glyph="" FontSize="12" />
                </Button>
              </Grid>
              <ScrollViewer x:Name="LyricsScroll" Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="LyricsPanel" Spacing="22" Padding="0,40,0,120" />
              </ScrollViewer>
              <TextBlock x:Name="LyricsPlaceholder" Grid.Row="1" Text="歌词会在这里，随着音乐浮现。" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="21" LineHeight="36" Foreground="{ThemeResource TextSecondary}" />
            </Grid>
          </Grid>
          <Border x:Name="SignalDetails" Grid.Row="2" VerticalAlignment="Center" CornerRadius="18" BorderBrush="{ThemeResource StrokeWeak}" BorderThickness="1" Padding="16,12" Background="{ThemeResource SignalChipBackground}">
            <Grid>
              <TextBlock x:Name="SignalPath" Text="等待播放 · 选择音频输出设备" Foreground="{ThemeResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,85,0" VerticalAlignment="Center" />
              <Button HorizontalAlignment="Right" Click="Settings_Click" Style="{StaticResource QuietButton}" Padding="5,0">
                <TextBlock Text="输出设置  ↗" FontSize="12" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <controls:GlassSurface x:Name="QueuePanel" Grid.Column="1" Width="340" HorizontalAlignment="Right" Visibility="Collapsed" Preset="Overlay">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
          </Grid.RowDefinitions>
          <TextBlock Text="接下来播放" FontSize="20" FontWeight="SemiBold" />
          <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Queue_Click" Style="{StaticResource QuietButton}" Padding="5">
            <FontIcon Glyph="" FontSize="12" />
          </Button>
          <ListView Grid.Row="1" x:Name="QueueList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Queue_ItemClick" DoubleTapped="Queue_DoubleTapped">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:Track">
                <StackPanel Margin="0,7" Spacing="5">
                  <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
                  <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Click="QueueUp_Click" Padding="10,5">
              <TextBlock Text="上移" FontSize="12" />
            </Button>
            <Button Click="QueueRemove_Click" Padding="10,5">
              <TextBlock Text="移除" FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </controls:GlassSurface>
    </Grid>
    <controls:GlassSurface Grid.Row="2" Margin="20,0,20,18" x:Name="PlayerGlass" Preset="Player">
      <Grid Margin="20,10" ColumnSpacing="20" x:Name="PlayerLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" x:Name="PlayerInfoColumn" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="190" x:Name="PlayerToolsColumn" />
        </Grid.ColumnDefinitions>
        <Grid ColumnSpacing="13">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
          </Grid.ColumnDefinitions>
          <Button x:Name="MiniCover" AutomationProperties.Name="打开正在播放" Click="Now_Click" Padding="0" Width="58" Height="58" CornerRadius="13" Background="{ThemeResource ButtonFill}">
            <Grid>
              <FontIcon Glyph="" Foreground="{ThemeResource TextSecondary}" FontSize="21" />
              <Image x:Name="MiniCoverImage" Stretch="UniformToFill" />
            </Grid>
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
            <TextBlock x:Name="MiniTitle" Text="还没有正在播放的音乐" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MiniArtist" Text="让喜欢的声音陪伴你" FontSize="12" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Click="FavoriteCurrent_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏">
            <FontIcon x:Name="CurrentHeart" Glyph="" FontSize="16" />
          </Button>
        </Grid>
        <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center" RowDefinitions="40,*" RowSpacing="2">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Click="Shuffle_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="随机播放" AutomationProperties.Name="随机播放">
              <FontIcon x:Name="ShuffleIcon" Glyph="" FontSize="14" Foreground="{ThemeResource TextSecondary}" />
            </Button>
            <Button Click="Previous_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="上一首" AutomationProperties.Name="上一首">
              <FontIcon Glyph="" FontSize="18" />
            </Button>
            <Button x:Name="PlayButton" Click="PlayPause_Click" Width="40" Height="40" CornerRadius="20" Background="{ThemeResource Accent}" Foreground="{ThemeResource PlayIconColor}" BorderThickness="0" Padding="0" ToolTipService.ToolTip="播放 / 暂停（空格）" AutomationProperties.Name="播放 / 暂停（空格）">
              <FontIcon x:Name="PlayIcon" Glyph="" FontSize="17" />
            </Button>
            <Button Click="Next_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首">
              <FontIcon Glyph="" FontSize="18" />
            </Button>
            <Button Click="Repeat_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="循环模式" AutomationProperties.Name="循环模式">
              <FontIcon x:Name="RepeatIcon" Glyph="" FontSize="14" Foreground="{ThemeResource TextSecondary}" />
            </Button>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="38,*,38" ColumnSpacing="8">
            <TextBlock Grid.Column="0" x:Name="Elapsed" Text="0:00" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
            <Slider Grid.Column="1" x:Name="SeekSlider" AutomationProperties.Name="播放进度" Minimum="0" Maximum="1" ValueChanged="Seek_Changed" IsThumbToolTipEnabled="False" VerticalAlignment="Center" Height="24" />
            <TextBlock Grid.Column="2" x:Name="Total" Text="0:00" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
          </Grid>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
          <Button Click="Settings_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="音频输出" AutomationProperties.Name="音频输出">
            <FontIcon Glyph="" FontSize="15" />
          </Button>
          <Slider x:Name="VolumeSlider" AutomationProperties.Name="音量" Width="80" Minimum="0" Maximum="100" Value="80" ValueChanged="Volume_Changed" ToolTipService.ToolTip="软件音量：DSD 透传时使用 DAC 控制" />
          <Button Visibility="Collapsed" Style="{StaticResource QuietButton}" AutomationProperties.Name="音量" x:Name="CompactVolume">
            <FontIcon Glyph="" FontSize="16" />
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="8">
                  <TextBlock Text="音量" />
                  <Slider Width="160" Minimum="0" Maximum="100" Value="{Binding Value,ElementName=VolumeSlider,Mode=TwoWay}" AutomationProperties.Name="弹出音量" x:Name="PopupVolumeSlider" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Click="Queue_Click" Style="{StaticResource QuietButton}" Padding="5" ToolTipService.ToolTip="播放队列" AutomationProperties.Name="播放队列">
            <FontIcon Glyph="" FontSize="17" />
          </Button>
